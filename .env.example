# Public (safe in the browser). Copy to .env.local — never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer Supabase dashboards label this "publishable". Either name works.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Required for staff CRM, event worker, and HubSpot ID storage.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin. Local development may use http://localhost:3000.
# On the deployed host, set this to the real https origin. Production email
# links omit the URL when this is empty or still localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini only if the assistant is enabled later. Not required for Phase 8.
# GEMINI_API_KEY=

# --- Phase 7/8 event worker (server only) ---
# Long random string, at least 16 characters. Never prefix with NEXT_PUBLIC_.
# Vercel Cron sends Authorization: Bearer $CRON_SECRET only when CRON_SECRET is set
# in the Vercel project environment. Do not put the value in vercel.json or the URL.
CRON_SECRET=
# Optional second secret for a manual server call. Either bearer value is accepted.
EVENTS_WORKER_SECRET=
# HMAC secret for inbound POST /api/webhooks/integrations (x-formshift-signature: sha256=...).
EVENTS_WEBHOOK_SECRET=
# Dry-run is on unless this is exactly false. Dry-run records skipped deliveries and does not call providers.
INTEGRATIONS_DRY_RUN=true

# n8n is not used. The Next.js event worker syncs inquiries to HubSpot directly.

# --- HubSpot (optional). Free CRM private app is enough. Paid seats/marketing not required. ---
# Private app access token. Scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write.
HUBSPOT_ACCESS_TOKEN=
# Pipeline and stage IDs from HubSpot Settings → Objects → Deals → Pipelines. Do not guess IDs.
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_NEW=
HUBSPOT_STAGE_CONTACTED=
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_STAGE_QUOTE_SENT=
HUBSPOT_STAGE_NEGOTIATION=
HUBSPOT_STAGE_WON=
HUBSPOT_STAGE_LOST=

# --- Resend (optional). Free tier: 100 emails/day, 3,000/month. Paid upgrades exist — do not turn them on without approval. ---
RESEND_API_KEY=
# Verified sender, e.g. FormShift AI <hello@your-domain>
RESEND_FROM_EMAIL=
# Internal notification inbox for new inquiries.
RESEND_INTERNAL_TO=
