# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dropped 3D assets (licence may forbid redistributing the raw file)
/public/models/**/*.glb
/public/models/**/*.gltf
/public/models/**/*.bin
/public/models/**/*.png
/public/models/**/*.jpg
/public/models/**/*.jpeg
/public/models/**/*.webp
